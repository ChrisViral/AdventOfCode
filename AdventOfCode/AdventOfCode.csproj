<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <OutputType>Exe</OutputType>
    <ApplicationIcon>Assets\aoc.ico</ApplicationIcon>
    <SignAssembly>true</SignAssembly>
    <AssemblyOriginatorKeyFile>Properties\AdventOfCode.snk</AssemblyOriginatorKeyFile>
    <Configurations>Release;Debug</Configurations>
    <Platforms>x64</Platforms>
  </PropertyGroup>

  <PropertyGroup>
    <BuildYear>$([System.DateTime]::UtcNow.ToString("yyyy"))</BuildYear>
    <BuildMonth>$([System.DateTime]::UtcNow.ToString("MM"))</BuildMonth>
    <MonthStart>$([System.DateTime]::Parse($([System.DateTime]::UtcNow.ToString("yyyy-MM-01"))))</MonthStart>
    <MonthMinutes>$([System.Math]::Floor($([System.DateTime]::UtcNow.Subtract($(MonthStart)).TotalMinutes)))</MonthMinutes>
    <DaySeconds>$([System.Math]::Floor($([System.DateTime]::UtcNow.Subtract($([System.DateTime]::Today)).TotalMinutes)))</DaySeconds>
    <Version>$(BuildYear).$(BuildMonth).$(MonthMinutes).$(DaySeconds)</Version>
    <AssemblyVersion>$(Version)</AssemblyVersion>
    <FileVersion>$(Version)</FileVersion>
  </PropertyGroup>

  <PropertyGroup Condition=" '$(Configuration)|$(Platform)' == 'Debug|x64' ">
    <CheckForOverflowUnderflow>true</CheckForOverflowUnderflow>
  </PropertyGroup>

  <PropertyGroup Condition=" '$(Configuration)|$(Platform)' == 'Release|x64' ">
    <DebugSymbols>true</DebugSymbols>
  </PropertyGroup>

  <PropertyGroup Condition=" '$(CI)' == 'true' ">
    <ContinuousIntegrationBuild>true</ContinuousIntegrationBuild>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="JetBrains.Annotations" Version="2026.2.0" />
    <PackageReference Include="JetBrains.ExternalAnnotations" Version="10.2.170" />
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="5.9.0" />
    <PackageReference Include="Microsoft.Z3" Version="4.12.2" />
    <PackageReference Include="Refit" Version="16.1.0" />
    <PackageReference Include="Refit.HttpClientFactory" Version="16.1.0" />
    <PackageReference Include="Refit.Reflection" Version="16.1.0" />
    <PackageReference Include="Serilog.Extensions.Logging" Version="10.0.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\AdventOfCode.Intcode\AdventOfCode.Intcode.csproj" />
    <ProjectReference Include="..\AdventOfCode.API\AdventOfCode.API.csproj" />
    <ProjectReference Include="..\Libraries\Challenge.CLI\Challenge.CLI.csproj" />
    <ProjectReference Include="..\Libraries\Challenge.Generator\Challenge.Generator.csproj"
                      OutputItemType="Analyzer"
                      ReferenceOutputAssembly="false" />
  </ItemGroup>

  <ItemGroup>
    <None Include="Input\**" />
    <None Include="Output\**" />
    <None Remove="AdventOfCode.csproj.DotSettings" />
  </ItemGroup>

</Project>
